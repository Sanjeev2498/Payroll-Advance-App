# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/

# Environment variables - Block all .env files EXCEPT .env.example
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local

# BUT allow .env.example files (they have placeholders, not secrets)
!.env.example
!**/.env.example

# Logs
logs
*.log

