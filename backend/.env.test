# JWT Configuration for Phase 3 Testing
JWT_SECRET=test-jwt-secret-key-for-phase-3-security-guards
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-secret-key-for-phase-3
JWT_REFRESH_EXPIRES_IN=7d

# Test Database URL (should already exist)
DATABASE_URL="postgresql://payroll_user:payroll_password@localhost:5432/payroll_test?schema=public"

# Test-specific settings
NODE_ENV=test
LOG_LEVEL=error
