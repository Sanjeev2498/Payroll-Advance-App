// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// CORE TENANT AND USER MANAGEMENT
// ============================================================================

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  settings  Json?    @db.JsonB
  branding  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  users       User[]
  clients     Client[]
  employees   Employee[]
  payrollRuns PayrollRun[]
  shiftTemplates ShiftTemplate[]
  shiftNotifications ShiftNotification[]

  @@map("companies")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  email        String    @unique @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(50)
  lastName     String    @map("last_name") @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(EMPLOYEE)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shiftNotifications ShiftNotification[]

  @@index([companyId])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  SUPERVISOR
  EMPLOYEE
}

// ============================================================================
// CLIENT AND SITE MANAGEMENT
// ============================================================================

model Client {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  name         String @db.VarChar(100)
  contactEmail String @map("contact_email") @db.VarChar(255)
  contactInfo  Json?  @map("contact_info") @db.JsonB

  // Organization details
  organizationType ClientOrganizationType @default(CORPORATE_OFFICE) @map("organization_type")
  industry         String?                @db.VarChar(100)
  companySize      String?                @map("company_size") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships (adjusted for contract model)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contracts Contract[] @relation("ClientContracts")

  @@index([companyId])
  @@index([organizationType])
  @@map("clients")
}

enum ContractStatus {
  ACTIVE
  PENDING
  EXPIRED
  TERMINATED
}

enum ClientUserRole {
  SECURITY_MANAGER
  FACILITY_MANAGER
  HR_MANAGER
  FINANCE_MANAGER
  REGIONAL_MANAGER
}

enum ClientOrganizationType {
  CORPORATE_OFFICE
  RESIDENTIAL_SOCIETY
  HOSPITAL
  SHOPPING_MALL
  FACTORY
  WAREHOUSE
  EDUCATIONAL_INSTITUTION
  GOVERNMENT_BUILDING
  HOTEL
}

// Contract entity between Client and Sites
model Contract {
  id                      String         @id @default(uuid()) @db.Uuid
  clientId                String         @map("client_id") @db.Uuid
  contractNumber          String         @map("contract_number") @db.VarChar(50)
  title                   String         @db.VarChar(200)
  description             String?        @db.Text
  status                  ContractStatus @default(ACTIVE)
  startDate               DateTime       @map("start_date") @db.Date
  endDate                 DateTime?      @map("end_date") @db.Date
  serviceDefinitions      Json?          @map("service_definitions") @db.JsonB
  serviceLevelAgreement   Json?          @map("service_level_agreement") @db.JsonB
  billingPreferences      Json?          @map("billing_preferences") @db.JsonB
  defaultBillingRates     Json?          @map("default_billing_rates") @db.JsonB
  contractValue           Decimal?       @map("contract_value") @db.Decimal(15, 2)
  paymentTerms            Json?          @map("payment_terms") @db.JsonB
  contractHistory         Json?          @map("contract_history") @db.JsonB
  renewalNotificationDays Int?           @default(90) @map("renewal_notification_days")
  autoRenewalEnabled      Boolean        @default(false) @map("auto_renewal_enabled")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  client   Client    @relation("ClientContracts", fields: [clientId], references: [id], onDelete: Cascade)
  sites    Site[]    @relation("ContractSites")
  invoices Invoice[] @relation("ContractInvoices")

  @@unique([clientId, contractNumber])
  @@index([clientId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("contracts")
}

// Client Users with role-based permissions - COMMENTED OUT until database migration
// model ClientUser {
//   ... ClientUser model will be enabled after database migration  
// }

// Client interactions for complaints, service requests, etc. - COMMENTED OUT until database migration
// model ClientInteraction {
//   ... ClientInteraction model will be enabled after database migration
// }

// Additional enums for client interactions - to be added with later migrations
// enum ClientInteractionType, ClientInteractionStatus

model Site {
  id                 String            @id @default(uuid()) @db.Uuid
  contractId         String            @map("contract_id") @db.Uuid
  name               String            @db.VarChar(100)
  address            Json              @db.JsonB
  accessRequirements Json?             @map("access_requirements") @db.JsonB
  safetyProtocols    Json?             @map("safety_protocols") @db.JsonB
  operationalStatus  OperationalStatus @default(ACTIVE) @map("operational_status")
  contactInfo        Json?             @map("contact_info") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships (adjusted for contract model)
  contract    Contract     @relation("ContractSites", fields: [contractId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  shifts      Shift[]
  // shiftTemplates ShiftTemplate[] // Commented out until migration

  @@index([contractId])
  @@index([operationalStatus])
  @@map("sites")
}

enum OperationalStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SUSPENDED
}

// ============================================================================
// EMPLOYEE AND WORKFORCE MANAGEMENT
// ============================================================================

model Employee {
  id             String @id @default(uuid()) @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  employeeNumber String @map("employee_number") @db.VarChar(20)
  firstName      String @map("first_name") @db.VarChar(50)
  lastName       String @map("last_name") @db.VarChar(50)

  // Contact information with encryption support
  email         String? @db.VarChar(255)
  emailIv       String? @map("email_iv") @db.VarChar(255)
  emailTag      String? @map("email_tag") @db.VarChar(255)
  phone         String? @db.VarChar(20)
  phoneIv       String? @map("phone_iv") @db.VarChar(255)
  phoneTag      String? @map("phone_tag") @db.VarChar(255)
  address       Json?   @db.JsonB

  // Salary information with encryption support
  basicSalary     String? @map("basic_salary") @db.VarChar(255)
  basicSalaryIv   String? @map("basic_salary_iv") @db.VarChar(255)
  basicSalaryTag  String? @map("basic_salary_tag") @db.VarChar(255)
  hraAmount       String? @map("hra_amount") @db.VarChar(255)
  hraAmountIv     String? @map("hra_amount_iv") @db.VarChar(255)
  hraAmountTag    String? @map("hra_amount_tag") @db.VarChar(255)

  // Metadata and other fields
  metadata         Json?            @db.JsonB
  certifications   Json?            @db.JsonB
  skills           String[]         @db.VarChar(50)
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  hireDate         DateTime         @map("hire_date") @db.Date
  terminationDate  DateTime?        @map("termination_date") @db.Date
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments       Assignment[]
  attendanceRecords Attendance[]
  payrollItems      PayrollItem[]

  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@index([companyId, employmentStatus])
  @@index([skills])
  @@map("employees")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

// Additional enums to be added with later migrations
// enum SalaryType, AccountType, etc.

model Assignment {
  id               String @id @default(uuid()) @db.Uuid
  employeeId       String @map("employee_id") @db.Uuid
  siteId           String @map("site_id") @db.Uuid
  role             String @db.VarChar(50)
  responsibilities Json?  @db.JsonB

  // Basic hourly rate (matching current database)
  hourlyRate    Decimal @map("hourly_rate") @db.Decimal(10, 2)
  hourlyRateIv  String? @map("hourly_rate_iv") @db.VarChar(255)
  hourlyRateTag String? @map("hourly_rate_tag") @db.VarChar(255)

  status    AssignmentStatus @default(ACTIVE)
  startDate DateTime         @map("start_date") @db.Date
  endDate   DateTime?        @map("end_date") @db.Date
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shifts   Shift[]

  @@index([employeeId])
  @@index([siteId])
  @@index([status])
  @@map("assignments")
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  CANCELLED
}

// ============================================================================
// SHIFT SCHEDULING AND ATTENDANCE
// ============================================================================

model Shift {
  id           String      @id @default(uuid()) @db.Uuid
  assignmentId String      @map("assignment_id") @db.Uuid
  siteId       String      @map("site_id") @db.Uuid
  shiftDate    DateTime    @map("shift_date") @db.Date
  startTime    DateTime    @map("start_time") @db.Time
  endTime      DateTime    @map("end_time") @db.Time
  shiftType    ShiftType   @default(REGULAR) @map("shift_type")
  status       ShiftStatus @default(SCHEDULED)
  notes        Json?       @db.JsonB
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  assignment        Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  site              Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attendanceRecords Attendance[]
  notifications     ShiftNotification[]

  @@index([assignmentId])
  @@index([siteId])
  @@index([shiftDate])
  @@index([status])
  @@map("shifts")
}

enum ShiftType {
  REGULAR
  OVERTIME
  HOLIDAY
  EMERGENCY
  TRAINING
  MAINTENANCE
}

enum ShiftStatus {
  DRAFT
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  NEEDS_COVERAGE
}

// Additional enums to be added with later migrations
// enum ShiftPriority, RecurrenceType, NotificationType, NotificationStatus

model Attendance {
  id               String           @id @default(uuid()) @db.Uuid
  employeeId       String           @map("employee_id") @db.Uuid
  shiftId          String           @map("shift_id") @db.Uuid
  clockIn          DateTime?        @map("clock_in") @db.Timestamptz
  clockOut         DateTime?        @map("clock_out") @db.Timestamptz
  locationData     Json?            @map("location_data") @db.JsonB
  status           AttendanceStatus @default(PENDING)
  verificationData Json?            @map("verification_data") @db.JsonB
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([shiftId])
  @@index([clockIn])
  @@index([status])
  @@map("attendance")
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  LATE
  EARLY_DEPARTURE
  OVERTIME
}

// ============================================================================
// PAYROLL AND BILLING
// ============================================================================

model PayrollRun {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  runNumber      String        @map("run_number") @db.VarChar(50)
  payPeriodStart DateTime      @map("pay_period_start") @db.Date
  payPeriodEnd   DateTime      @map("pay_period_end") @db.Date
  status         PayrollStatus @default(DRAFT)
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  processedAt    DateTime?     @map("processed_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollItems PayrollItem[]

  @@unique([companyId, runNumber])
  @@index([companyId])
  @@index([status])
  @@map("payroll_runs")
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

model PayrollItem {
  id           String          @id @default(uuid()) @db.Uuid
  payrollRunId String          @map("payroll_run_id") @db.Uuid
  employeeId   String          @map("employee_id") @db.Uuid
  itemType     PayrollItemType @map("item_type")
  description  String          @db.VarChar(255)

  // Basic amount (matching current database)
  amount Decimal @db.Decimal(10, 2)

  calculationData Json?    @map("calculation_data") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([itemType])
  @@map("payroll_items")
}

enum PayrollItemType {
  BASIC_PAY
  OVERTIME
  BONUS
  ALLOWANCE
  TAX_DEDUCTION
  SOCIAL_SECURITY
  HEALTH_INSURANCE
  OTHER_DEDUCTION
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  contractId         String        @map("contract_id") @db.Uuid
  invoiceNumber      String        @map("invoice_number") @db.VarChar(50)
  billingPeriodStart DateTime      @map("billing_period_start") @db.Date
  billingPeriodEnd   DateTime      @map("billing_period_end") @db.Date
  subtotal           Decimal       @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  status             InvoiceStatus @default(DRAFT)
  dueDate            DateTime      @map("due_date") @db.Date
  paidAt             DateTime?     @map("paid_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships (adjusted for contract model)
  contract Contract @relation("ContractInvoices", fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([invoiceNumber])
  @@index([contractId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ============================================================================
// SHIFT SCHEDULING SYSTEM EXTENSIONS
// ============================================================================

model ShiftTemplate {
  id                  String            @id @default(uuid()) @db.Uuid
  companyId           String            @map("company_id") @db.Uuid
  name                String            @db.VarChar(100)
  description         String?           @db.Text
  shiftType           ShiftType         @default(REGULAR) @map("shift_type")
  startTime           DateTime          @map("start_time") @db.Time
  endTime             DateTime          @map("end_time") @db.Time
  daysOfWeek          Int[]             @map("days_of_week") // Array of integers 0-6 (Sunday-Saturday)
  isActive            Boolean           @default(true) @map("is_active")
  skillRequirements   String[]          @map("skill_requirements") @db.VarChar(50)
  minStaffRequired    Int               @default(1) @map("min_staff_required")
  maxStaffAllowed     Int?              @map("max_staff_allowed")
  autoAssign          Boolean           @default(false) @map("auto_assign")
  priority            Int               @default(1) // 1 = highest, 5 = lowest
  recurrence          Json?             @db.JsonB // For complex recurrence patterns
  effectiveFrom       DateTime          @map("effective_from") @db.Date
  effectiveTo         DateTime?         @map("effective_to") @db.Date
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // sites   Site[]  @relation("SiteShiftTemplates") // Many-to-many relationship

  @@index([companyId])
  @@index([isActive])
  @@index([shiftType])
  @@map("shift_templates")
}

model ShiftNotification {
  id               String               @id @default(uuid()) @db.Uuid
  companyId        String               @map("company_id") @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  shiftId          String?              @map("shift_id") @db.Uuid
  notificationType NotificationType     @map("notification_type")
  title            String               @db.VarChar(200)
  message          String               @db.Text
  status           NotificationStatus   @default(PENDING)
  scheduledFor     DateTime?            @map("scheduled_for") @db.Timestamptz
  sentAt           DateTime?            @map("sent_at") @db.Timestamptz
  readAt           DateTime?            @map("read_at") @db.Timestamptz
  metadata         Json?                @db.JsonB
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([shiftId])
  @@index([status])
  @@index([scheduledFor])
  @@map("shift_notifications")
}

enum NotificationType {
  SHIFT_ASSIGNED
  SHIFT_CANCELLED
  SHIFT_REMINDER
  SCHEDULE_UPDATED
  OVERTIME_AVAILABLE
  COVERAGE_NEEDED
  ATTENDANCE_REQUIRED
  EMERGENCY_ALERT
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

