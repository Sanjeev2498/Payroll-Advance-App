generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model assignments {
  id               String           @id @db.Uuid
  employee_id      String           @db.Uuid
  site_id          String           @db.Uuid
  role             String           @db.VarChar(50)
  responsibilities Json?
  hourly_rate      String           @db.VarChar(500)
  status           AssignmentStatus @default(ACTIVE)
  start_date       DateTime         @db.Date
  end_date         DateTime?        @db.Date
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @db.Timestamptz(6)
  hourly_rate_iv   String           @db.VarChar(32)
  hourly_rate_tag  String           @db.VarChar(32)
  employees        employees        @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  sites            sites            @relation(fields: [site_id], references: [id], onDelete: Cascade)
  shifts           shifts[]

  @@index([employee_id])
  @@index([site_id])
  @@index([status])
  @@index([employee_id, site_id], map: "idx_assignments_employee_site_rls", where: raw("((employee_id IS NOT NULL) AND (site_id IS NOT NULL))"))
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attendance {
  id                String           @id @db.Uuid
  employee_id       String           @db.Uuid
  shift_id          String           @db.Uuid
  clock_in          DateTime?        @db.Timestamptz(6)
  clock_out         DateTime?        @db.Timestamptz(6)
  location_data     Json?
  status            AttendanceStatus @default(PENDING)
  verification_data Json?
  notes             String?
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @db.Timestamptz(6)
  employees         employees        @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  shifts            shifts           @relation(fields: [shift_id], references: [id], onDelete: Cascade)

  @@index([clock_in])
  @@index([employee_id])
  @@index([shift_id])
  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model clients {
  id                  String                  @id @db.Uuid
  company_id          String                  @db.Uuid
  name                String                  @db.VarChar(100)
  contact_email       String                  @db.VarChar(255)
  contact_info        Json?
  contract_status     ContractStatus          @default(ACTIVE)
  contract_start      DateTime?               @db.Date
  contract_end        DateTime?               @db.Date
  billing_preferences Json?
  created_at          DateTime                @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                @db.Timestamptz(6)
  company_size        String?
  industry            String?
  organization_type   ClientOrganizationType?
  tags                String[]                @default([])
  companies           companies               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  contracts           contracts[]
  invoices            invoices[]
  sites               sites[]
  client_users        client_users[]

  @@index([company_id, contract_status])
  @@index([company_id])
  @@index([company_id], map: "idx_clients_company_id_rls", where: raw("(company_id IS NOT NULL)"))
  @@index([organization_type], map: "idx_clients_organization_type")
}

/// Client Users - Users who can access client portal
/// This model contains row level security and requires additional setup for migrations.
model client_users {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id     String         @db.Uuid
  email         String         @unique @db.VarChar(255)
  first_name    String         @db.VarChar(50)
  last_name     String         @db.VarChar(50)
  role          ClientUserRole
  phone         String?        @db.VarChar(20)
  job_title     String?        @db.VarChar(100)
  department    String?        @db.VarChar(100)
  is_active     Boolean        @default(true)
  last_login_at DateTime?      @db.Timestamptz(6)
  invited_at    DateTime?      @db.Timestamptz(6)
  activated_at  DateTime?      @db.Timestamptz(6)
  permissions   Json?
  preferences   Json?
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @db.Timestamptz(6)
  
  // Relations
  client        clients        @relation(fields: [client_id], references: [id], onDelete: Cascade)
  
  // Indexes for performance
  @@index([client_id])
  @@index([email])
  @@index([role])
  @@index([is_active])
  @@index([client_id, is_active])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model companies {
  id              String            @id @db.Uuid
  name            String            @db.VarChar(100)
  slug            String            @unique @db.VarChar(50)
  settings        Json?
  branding        Json?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @db.Timestamptz(6)
  clients         clients[]
  employees       employees[]
  payroll_runs    payroll_runs[]
  shift_templates shift_templates[]
  users           users[]
}

model contracts {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id           String         @db.Uuid
  contract_number     String         @db.VarChar(50)
  title               String         @db.VarChar(200)
  description         String?
  status              ContractStatus @default(ACTIVE)
  start_date          DateTime       @db.Date
  end_date            DateTime?      @db.Date
  service_definitions Json?
  billing_preferences Json?
  contract_value      Decimal?       @db.Decimal(15, 2)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @db.Timestamptz(6)
  clients             clients        @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sites               sites[]

  @@unique([client_id, contract_number])
  @@index([client_id], map: "idx_contracts_client_id")
  @@index([client_id], map: "idx_contracts_client_id_rls", where: raw("(client_id IS NOT NULL)"))
  @@index([status], map: "idx_contracts_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model employees {
  id                   String                @id @db.Uuid
  company_id           String                @db.Uuid
  employee_number      String                @db.VarChar(20)
  first_name           String                @db.VarChar(50)
  last_name            String                @db.VarChar(50)
  email                String?               @db.VarChar(500)
  phone                String?               @db.VarChar(500)
  address              Json?
  certifications       Json?
  skills               String[]              @db.VarChar(50)
  employment_status    EmploymentStatus      @default(ACTIVE)
  hire_date            DateTime              @db.Date
  termination_date     DateTime?             @db.Date
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @db.Timestamptz(6)
  aadhaar_number       String?               @db.VarChar(500)
  metadata             Json?
  pan_number           String?               @db.VarChar(500)
  aadhaar_iv           String?               @db.VarChar(32)
  aadhaar_tag          String?               @db.VarChar(32)
  email_iv             String?               @db.VarChar(32)
  email_tag            String?               @db.VarChar(32)
  pan_iv               String?               @db.VarChar(32)
  pan_tag              String?               @db.VarChar(32)
  phone_iv             String?               @db.VarChar(32)
  phone_tag            String?               @db.VarChar(32)
  account_number       String?               @db.VarChar(500)
  account_number_iv    String?               @db.VarChar(32)
  account_number_tag   String?               @db.VarChar(32)
  account_type         AccountType           @default(SAVINGS)
  bank_name            String?               @db.VarChar(500)
  bank_name_iv         String?               @db.VarChar(32)
  bank_name_tag        String?               @db.VarChar(32)
  basic_salary         String?               @db.VarChar(500)
  basic_salary_iv      String?               @db.VarChar(32)
  basic_salary_tag     String?               @db.VarChar(32)
  date_of_birth        DateTime?             @db.Date
  epf_applicable       Boolean               @default(true)
  esic_applicable      Boolean               @default(true)
  esic_number          String?               @db.VarChar(500)
  esic_number_iv       String?               @db.VarChar(32)
  esic_number_tag      String?               @db.VarChar(32)
  gross_salary         String?               @db.VarChar(500)
  gross_salary_iv      String?               @db.VarChar(32)
  gross_salary_tag     String?               @db.VarChar(32)
  hra_amount           String?               @db.VarChar(500)
  hra_amount_iv        String?               @db.VarChar(32)
  hra_amount_tag       String?               @db.VarChar(32)
  ifsc_code            String?               @db.VarChar(500)
  ifsc_code_iv         String?               @db.VarChar(32)
  ifsc_code_tag        String?               @db.VarChar(32)
  other_allowances     String?               @db.VarChar(500)
  other_allowances_iv  String?               @db.VarChar(32)
  other_allowances_tag String?               @db.VarChar(32)
  pt_applicable        Boolean               @default(true)
  salary_type          SalaryType            @default(MONTHLY)
  tds_applicable       Boolean               @default(true)
  uan_number           String?               @db.VarChar(500)
  uan_number_iv        String?               @db.VarChar(32)
  uan_number_tag       String?               @db.VarChar(32)
  assignments          assignments[]
  attendance           attendance[]
  companies            companies             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  payroll_items        payroll_items[]
  shift_notifications  shift_notifications[]

  @@unique([company_id, employee_number])
  @@index([company_id, employment_status])
  @@index([company_id])
  @@index([skills])
  @@index([company_id], map: "idx_employees_company_id_rls", where: raw("(company_id IS NOT NULL)"))
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invoices {
  id                   String        @id @db.Uuid
  client_id            String        @db.Uuid
  invoice_number       String        @unique @db.VarChar(50)
  billing_period_start DateTime      @db.Date
  billing_period_end   DateTime      @db.Date
  subtotal             Decimal       @db.Decimal(12, 2)
  tax_amount           Decimal       @default(0) @db.Decimal(12, 2)
  total_amount         Decimal       @db.Decimal(12, 2)
  status               InvoiceStatus @default(DRAFT)
  due_date             DateTime      @db.Date
  paid_at              DateTime?     @db.Timestamptz(6)
  created_at           DateTime      @default(now()) @db.Timestamptz(6)
  updated_at           DateTime      @db.Timestamptz(6)
  additional_charges   Json?
  deployment_summary   Json?
  gst_details          Json?
  notes                String?
  payment_reference    String?       @db.VarChar(255)
  clients              clients       @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@index([due_date])
  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payroll_items {
  id               String          @id @db.Uuid
  payroll_run_id   String          @db.Uuid
  employee_id      String          @db.Uuid
  item_type        PayrollItemType
  description      String          @db.VarChar(255)
  amount           String          @db.VarChar(500)
  calculation_data Json?
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @db.Timestamptz(6)
  amount_iv        String          @db.VarChar(32)
  amount_tag       String          @db.VarChar(32)
  employees        employees       @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  payroll_runs     payroll_runs    @relation(fields: [payroll_run_id], references: [id], onDelete: Cascade)

  @@index([payroll_run_id], map: "idx_payroll_items_payroll_run_id_rls", where: raw("(payroll_run_id IS NOT NULL)"))
  @@index([employee_id])
  @@index([item_type])
  @@index([payroll_run_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payroll_runs {
  id               String          @id @db.Uuid
  company_id       String          @db.Uuid
  run_number       String          @db.VarChar(50)
  pay_period_start DateTime        @db.Date
  pay_period_end   DateTime        @db.Date
  status           PayrollStatus   @default(DRAFT)
  total_amount     Decimal         @default(0) @db.Decimal(12, 2)
  processed_at     DateTime?       @db.Timestamptz(6)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @db.Timestamptz(6)
  payroll_items    payroll_items[]
  companies        companies       @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, run_number])
  @@index([company_id])
  @@index([status])
}

model shift_notifications {
  id            String             @id @db.Uuid
  shift_id      String             @db.Uuid
  user_id       String?            @db.Uuid
  employee_id   String?            @db.Uuid
  type          NotificationType
  title         String             @db.VarChar(255)
  message       String
  status        NotificationStatus @default(PENDING)
  scheduled_for DateTime?          @db.Timestamptz(6)
  sent_at       DateTime?          @db.Timestamptz(6)
  read_at       DateTime?          @db.Timestamptz(6)
  metadata      Json?
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @db.Timestamptz(6)
  employees     employees?         @relation(fields: [employee_id], references: [id])
  shifts        shifts             @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  users         users?             @relation(fields: [user_id], references: [id])

  @@index([employee_id])
  @@index([scheduled_for])
  @@index([shift_id])
  @@index([status])
  @@index([type])
  @@index([user_id])
}

model shift_templates {
  id                 String    @id @db.Uuid
  company_id         String    @db.Uuid
  name               String    @db.VarChar(100)
  description        String?
  site_id            String?   @db.Uuid
  start_time         DateTime  @db.Time(6)
  end_time           DateTime  @db.Time(6)
  shift_type         ShiftType @default(REGULAR)
  coverage_required  Int       @default(1)
  skill_requirements Json?
  shift_requirements Json?
  break_schedule     Json?
  recurrence_pattern Json?
  is_active          Boolean   @default(true)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @db.Timestamptz(6)
  companies          companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  sites              sites?    @relation(fields: [site_id], references: [id])
  shifts             shifts[]

  @@index([company_id])
  @@index([is_active])
  @@index([site_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shifts {
  id                  String                @id @db.Uuid
  assignment_id       String?               @db.Uuid
  site_id             String                @db.Uuid
  shift_date          DateTime              @db.Date
  start_time          DateTime              @db.Time(6)
  end_time            DateTime              @db.Time(6)
  shift_type          ShiftType             @default(REGULAR)
  status              ShiftStatus           @default(SCHEDULED)
  notes               Json?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @db.Timestamptz(6)
  break_schedule      Json?
  coverage_assigned   Int                   @default(0)
  coverage_required   Int                   @default(1)
  is_recurring        Boolean               @default(false)
  modification_log    Json?
  priority            ShiftPriority         @default(NORMAL)
  recurring_pattern   Json?
  shift_requirements  Json?
  skill_requirements  Json?
  template_id         String?               @db.Uuid
  attendance          attendance[]
  shift_notifications shift_notifications[]
  assignments         assignments?          @relation(fields: [assignment_id], references: [id])
  sites               sites                 @relation(fields: [site_id], references: [id], onDelete: Cascade)
  shift_templates     shift_templates?      @relation(fields: [template_id], references: [id])

  @@index([assignment_id], map: "idx_shifts_assignment_id_rls", where: raw("(assignment_id IS NOT NULL)"))
  @@index([assignment_id])
  @@index([is_recurring])
  @@index([priority])
  @@index([shift_date])
  @@index([site_id])
  @@index([status])
  @@index([template_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sites {
  id                  String            @id @db.Uuid
  client_id           String            @db.Uuid
  name                String            @db.VarChar(100)
  address             Json
  access_requirements Json?
  safety_protocols    Json?
  operational_status  OperationalStatus @default(ACTIVE)
  contact_info        Json?
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @db.Timestamptz(6)
  contract_id         String?           @db.Uuid
  min_staffing_level  Int?              @default(1)
  max_staffing_level  Int?
  assignments         assignments[]
  shift_templates     shift_templates[]
  shifts              shifts[]
  clients             clients           @relation(fields: [client_id], references: [id], onDelete: Cascade)
  contracts           contracts?        @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sites_contract_id")

  @@index([contract_id], map: "idx_sites_contract_id")
  @@index([contract_id], map: "idx_sites_contract_id_rls", where: raw("(contract_id IS NOT NULL)"))
  @@index([operational_status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                  String                @id @db.Uuid
  company_id          String                @db.Uuid
  email               String                @unique @db.VarChar(255)
  first_name          String                @db.VarChar(50)
  last_name           String                @db.VarChar(50)
  password_hash       String                @db.VarChar(255)
  role                UserRole              @default(EMPLOYEE)
  is_active           Boolean               @default(true)
  last_login_at       DateTime?             @db.Timestamptz(6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @db.Timestamptz(6)
  shift_notifications shift_notifications[]
  companies           companies             @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
}

enum AccountType {
  SAVINGS
  CURRENT
  SALARY
  JOINT
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  LATE
  EARLY_DEPARTURE
  OVERTIME
}

enum ClientOrganizationType {
  CORPORATE_OFFICE
  RESIDENTIAL_SOCIETY
  HOSPITAL
  SHOPPING_MALL
  FACTORY
  WAREHOUSE
  EDUCATIONAL_INSTITUTION
  GOVERNMENT_BUILDING
  HOTEL
}

enum ClientUserRole {
  SECURITY_MANAGER
  FACILITY_MANAGER
  HR_MANAGER
  FINANCE_MANAGER
  REGIONAL_MANAGER
}

enum ContractStatus {
  ACTIVE
  PENDING
  EXPIRED
  TERMINATED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum NotificationType {
  SHIFT_ASSIGNED
  SHIFT_CHANGED
  SHIFT_CANCELLED
  COVERAGE_REQUEST
  SHIFT_REMINDER
  OVERTIME_ALERT
}

enum OperationalStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SUSPENDED
}

enum PayrollItemType {
  BASIC_PAY
  OVERTIME
  BONUS
  ALLOWANCE
  TAX_DEDUCTION
  SOCIAL_SECURITY
  HEALTH_INSURANCE
  OTHER_DEDUCTION
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

enum RecurrenceType {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum SalaryType {
  MONTHLY
  DAILY
  HOURLY
}

enum ShiftPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  DRAFT
  CONFIRMED
  NEEDS_COVERAGE
}

enum ShiftType {
  REGULAR
  OVERTIME
  HOLIDAY
  EMERGENCY
  TRAINING
  MAINTENANCE
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  SUPERVISOR
  EMPLOYEE
}
