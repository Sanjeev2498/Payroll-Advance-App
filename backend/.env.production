# Production Environment Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/payroll_system_production?schema=public"

# Application Configuration
NODE_ENV="production"
PORT=3001

# JWT Configuration
JWT_SECRET="CHANGE_THIS_IN_PRODUCTION_SECURE_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="CHANGE_THIS_IN_PRODUCTION"

# Application Security
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN="https://your-production-domain.com"

# Logging
LOG_LEVEL="info"

# Monitoring
SENTRY_DSN=""
NEW_RELIC_LICENSE_KEY=""
